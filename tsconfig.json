{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,

    "lib": ["ESNext", "DOM"],

    "strict": true,

    "allowJs": true,
    "checkJs": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,

    "types": ["node"],

    "skipLibCheck": true,

    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },

  "include": ["frontend/src/**/*.ts", "vite.config.ts"],
  "exclude": ["public/dist", "result", "node_modules"]
}
